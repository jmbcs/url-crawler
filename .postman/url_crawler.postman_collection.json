    {
      "name": "Submit a crawl",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/crawls",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "crawls"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seed\": \"{{seed}}\",\n  \"max_pages\": {{maxPages}},\n  \"concurrency\": {{concurrency}}\n}"
        },
        "description": "Queues a crawl and returns 202 with a Location header. The crawl runs on a worker, not in the API. Edit seed, maxPages and concurrency in the Variables tab; the two numbers are unquoted in the body because the API rejects them as strings. The test script stores the new id in crawlId, so every request below works with no copying."
      },
      "response": [
        {
          "name": "202 Accepted",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/crawls",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "crawls"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seed\": \"{{seed}}\",\n  \"max_pages\": {{maxPages}},\n  \"concurrency\": {{concurrency}}\n}"
            }
          },
          "status": "Accepted",
          "code": 202,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "{\n  \"id\": \"2e86cfce-4176-4135-8fcb-8e4db990945e\",\n  \"seed\": \"https://crawler-test.com/\",\n  \"state\": \"queued\",\n  \"config\": {\n    \"timeout\": 10.0,\n    \"max_bytes\": 5000000,\n    \"max_pages\": 25,\n    \"concurrency\": 5,\n    \"respect_robots\": true\n  },\n  \"created_at\": \"2026-09-11T18:49:03.428737Z\",\n  \"started_at\": null,\n  \"finished_at\": null,\n  \"attempts\": 0,\n  \"cancel_requested\": false,\n  \"stats\": null,\n  \"error\": null\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Save the new crawl id so every other request can use {{crawlId}}.",
              "if (pm.response.code === 202) {",
              "    pm.collectionVariables.set('crawlId', pm.response.json().id);",
              "}",
              "pm.test('queued', () => pm.response.to.have.status(202));"
            ]
          }
        }
      ]
    },
    {
      "name": "Submit a crawl, refused seed",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/crawls",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "crawls"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seed\": \"{{privateSeed}}\"\n}"
        },
        "description": "The service resolves the seed host and refuses anything on a private, loopback or link-local address, so an unauthenticated caller cannot use it to reach inside the network. privateSeed holds the address to try. The CLI has no such guard, because your own terminal already reaches those."
      },
      "response": [
        {
          "name": "422 private address",
          "originalRequest": {
            "method": "POST",
