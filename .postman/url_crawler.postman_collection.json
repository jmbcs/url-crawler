              "path": [
                "crawls"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "2"
                },
                {
                  "key": "state",
                  "value": "finished"
                }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "{\n  \"items\": [\n    {\n      \"id\": \"f77a4481-05c4-4e34-a41f-487a3ae70dee\",\n      \"seed\": \"https://crawler-test.com/\",\n      \"state\": \"finished\",\n      \"config\": {\n        \"timeout\": 10.0,\n        \"max_bytes\": 5000000,\n        \"max_pages\": 25,\n        \"concurrency\": 5,\n        \"respect_robots\": true\n      },\n      \"created_at\": \"2026-09-10T11:37:22.316256Z\",\n      \"started_at\": \"2026-09-10T11:37:22.562254Z\",\n      \"finished_at\": \"2026-09-10T11:37:27.502166Z\",\n      \"attempts\": 1,\n      \"cancel_requested\": false,\n      \"stats\": {\n        \"retries\": 0,\n        \"pages_ok\": 25,\n        \"redirects\": 0,\n        \"links_found\": 431,\n        \"pages_total\": 25,\n        \"pages_failed\": {},\n        \"elapsed_seconds\": 4.881,\n        \"duplicates_dropped\": 21,\n        \"pages_without_links\": 5\n      },\n      \"error\": null\n    },\n    {\n      \"id\": \"fc7e9a7c-35fa-4f91-ad3e-47f16233c337\",\n      \"seed\": \"https://example.com/\",\n      \"state\": \"finished\",\n      \"config\": {\n        \"timeout\": 10.0,\n        \"max_bytes\": 5000000,\n        \"max_pages\": 5,\n        \"concurrency\": 10,\n        \"respect_robots\": true\n      },\n      \"created_at\": \"2026-09-09T16:22:29.688262Z\",\n      \"started_at\": \"2026-09-09T16:22:30.591844Z\",\n      \"finished_at\": \"2026-09-09T16:22:30.998959Z\",\n      \"attempts\": 1,\n      \"cancel_requested\": false,\n      \"stats\": {\n        \"retries\": 0,\n        \"pages_ok\": 1,\n        \"redirects\": 0,\n        \"links_found\": 1,\n        \"pages_total\": 1,\n        \"pages_failed\": {},\n        \"elapsed_seconds\": 0.268,\n        \"duplicates_dropped\": 0,\n        \"pages_without_links\": 0\n      },\n      \"error\": null\n    }\n  ]\n}"
        }
