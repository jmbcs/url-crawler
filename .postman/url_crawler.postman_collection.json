        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Hand the cursor to Read the next batch.",
              "const next = pm.response.json().next_after;",
              "if (next !== null) {",
              "    pm.collectionVariables.set('afterSeq', next);",
              "}",
              "pm.test('a batch came back', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
