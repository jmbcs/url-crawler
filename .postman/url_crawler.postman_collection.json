    {
      "name": "Cancel a crawl",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/crawls/{{crawlId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "crawls",
            "{{crawlId}}"
          ]
        },
        "description": "A request, not a kill. A queued crawl aborts outright. A running one stops at its worker's next heartbeat and keeps the pages it already wrote. A finished one is returned unchanged."
      },
      "response": [
