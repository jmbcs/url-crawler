  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string",
      "description": "Where the API listens."
    },
    {
      "key": "crawlId",
      "value": "",
      "type": "string",
      "description": "The crawl every request below reads. Submit a crawl fills this in from its 202 response, so you never copy an id by hand."
    },
    {
      "key": "seed",
      "value": "https://crawler-test.com",
      "type": "string",
      "description": "The site to crawl."
    },
    {
      "key": "maxPages",
      "value": "25",
