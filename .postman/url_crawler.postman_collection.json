    {
      "name": "Read the pages",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/crawls/{{crawlId}}/pages?limit=3",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "crawls",
            "{{crawlId}}",
            "pages"
          ],
          "query": [
            {
              "key": "limit",
              "value": "3"
            }
          ]
        },
        "description": "One object per page fetched, readable while the crawl is still running. Keyset pagination: pass the last seq you saw as after. next_after is null once you have read everything written so far, which is not the same as the crawl being over."
      },
      "response": [
        {
          "name": "200 first batch",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/crawls/{{crawlId}}/pages?limit=3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "crawls",
                "{{crawlId}}",
                "pages"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "3"
                }
              ]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "{\n  \"items\": [\n    {\n      \"seq\": 1,\n      \"url\": \"https://crawler-test.com/\",\n      \"status\": 200,\n      \"error\": null,\n      \"links\": [\n        \"https://crawler-test.com/\",\n        \"https://crawler-test.com/mobile/separate_desktop\",\n        \"https://crawler-test.com/mobile/desktop_with_AMP_as_mobile\",\n        \"https://crawler-test.com/mobile/separate_desktop_with_different_h1\",\n        \"... 407 more\"\n      ],\n      \"fetched_at\": \"2026-09-10T11:37:24.641429Z\"\n    },\n    {\n      \"seq\": 2,\n      \"url\": \"https://crawler-test.com/mobile/separate_desktop\",\n      \"status\": 200,\n      \"error\": null,\n      \"links\": [\n        \"https://crawler-test.com/\"\n      ],\n      \"fetched_at\": \"2026-09-10T11:37:24.995216Z\"\n    },\n    {\n      \"seq\": 3,\n      \"url\": \"https://crawler-test.com/mobile/separate_desktop_with_different_links_in\",\n      \"status\": 200,\n      \"error\": null,\n      \"links\": [\n        \"https://crawler-test.com/\"\n      ],\n      \"fetched_at\": \"2026-09-10T11:37:25.277252Z\"\n    }\n  ],\n  \"next_after\": 3\n}"
        }
