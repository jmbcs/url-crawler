    {
      "name": "Read the next batch",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/crawls/{{crawlId}}/pages?after=3&limit=3",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "crawls",
