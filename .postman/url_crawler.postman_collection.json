    {
      "name": "Submit a crawl",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/crawls",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "crawls"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seed\": \"https://crawler-test.com\",\n  \"max_pages\": 25,\n  \"concurrency\": 5\n}"
        },
        "description": "Queues a crawl and returns 202 with a Location header. The crawl runs on a worker, not in the API. The test script stores the id in the collection variable crawlId, so every request below works with no copying."
      },
      "response": [
        {
          "name": "202 Accepted",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/crawls",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "crawls"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seed\": \"https://crawler-test.com\",\n  \"max_pages\": 25,\n  \"concurrency\": 5\n}"
            }
          },
          "status": "Accepted",
          "code": 202,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "{\n  \"id\": \"f77a4481-05c4-4e34-a41f-487a3ae70dee\",\n  \"seed\": \"https://crawler-test.com/\",\n  \"state\": \"queued\",\n  \"config\": {\n    \"timeout\": 10.0,\n    \"max_bytes\": 5000000,\n    \"max_pages\": 25,\n    \"concurrency\": 5,\n    \"respect_robots\": true\n  },\n  \"created_at\": \"2026-09-10T11:37:22.316256Z\",\n  \"started_at\": null,\n  \"finished_at\": null,\n  \"attempts\": 0,\n  \"cancel_requested\": false,\n  \"stats\": null,\n  \"error\": null\n}"
        }
      ],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Save the new crawl id so every other request can use {{crawlId}}.",
              "if (pm.response.code === 202) {",
              "    pm.collectionVariables.set('crawlId', pm.response.json().id);",
              "}",
              "pm.test('queued', () => pm.response.to.have.status(202));"
            ]
          }
        }
      ]
    },
    {
      "name": "Submit a crawl, refused seed",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/crawls",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "crawls"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"seed\": \"http://169.254.169.254/latest/meta-data/\"\n}"
        },
        "description": "The service resolves the seed host and refuses anything on a private, loopback or link-local address, so an unauthenticated caller cannot use it to reach inside the network. The CLI has no such guard, because your own terminal already reaches those."
      },
      "response": [
        {
          "name": "422 private address",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/crawls",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "crawls"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seed\": \"http://169.254.169.254/latest/meta-data/\"\n}"
            }
          },
          "status": "Unprocessable Entity",
          "code": 422,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "cookie": [],
          "body": "{\n  \"detail\": {\n    \"seed\": \"169.254.169.254 is a private address\"\n  }\n}"
        }
      ]
    },
    {
      "name": "List crawls",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/crawls?limit=2&state=finished",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "crawls"
          ],
          "query": [
            {
              "key": "limit",
              "value": "2"
            },
            {
              "key": "state",
              "value": "finished"
            }
          ]
        },
        "description": "Newest first. Filter with state, one of queued, running, finished, failed or aborted. limit is 1 to 200 and defaults to 50."
      },
      "response": [
        {
          "name": "200 OK",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/crawls?limit=2&state=finished",
