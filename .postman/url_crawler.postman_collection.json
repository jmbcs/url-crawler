{
  "info": {
    "name": "url-crawler",
    "description": "The url-crawler job service. Start it with `docker compose up --build -d`, then run Submit a crawl first: it stores the new id in the crawlId variable that every other request uses. Every tunable value is a collection variable, so edit the seed, the page cap, the concurrency, the batch size and the cursor in the Variables tab rather than in the requests. Every saved example below is a real response, captured against https://crawler-test.com.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
