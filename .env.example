# Postgres user the crawl service connects as
POSTGRES_USER=crawler
# Postgres password for POSTGRES_USER
POSTGRES_PASSWORD=crawler
# Name of the default database, used by the api, worker and migrate targets
POSTGRES_DB=crawler
# Host port Postgres is published on
POSTGRES_PORT=55432
# Host port the API listens on
API_PORT=8000
# SQLAlchemy async URL for local (non-Docker) runs of migrate, api and worker
DATABASE_URL=postgresql+asyncpg://crawler:crawler@localhost:55432/crawler
# Database the service tests run against, kept separate from DATABASE_URL
URL_CRAWLER_TEST_DATABASE_URL=postgresql+asyncpg://crawler:crawler@localhost:55432/crawler_test
# Worker poll interval when the queue is empty or the database is unreachable
WORKER_POLL_SECONDS=1.0
# Worker lease refresh and cancel-check interval
HEARTBEAT_SECONDS=5.0
# How long the reaper tolerates a silent worker before acting on its lease
LEASE_SECONDS=30.0
# Attempts below this are requeued by the reaper, at it they are failed
MAX_ATTEMPTS=3
# DbReporter page-count flush trigger
PAGE_BATCH_SIZE=100
# DbReporter time-based flush trigger, in seconds
PAGE_FLUSH_SECONDS=0.2
